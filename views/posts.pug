doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700&display=swap")
    link(rel="stylesheet" href="style.css")
    title ひとことチャット
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.app-navbar
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto ひとことチャット
          i.bi-chat-dots-fill.ms-1
        div.dropdown 
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{user}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li
              a.dropdown-item(href="/changeTheme") ライトモード・ダークモードの切り替え
              a.dropdown-item(href="/logout") ログアウト

    each post in posts
      //- 自分の投稿は右寄せ(post-mine)、他の人の投稿は左寄せの吹き出し風カードにする
      - const cardClass = (user === post.postedBy ? 'card my-3 post-card post-mine' : 'card my-3 post-card')
      //- 名前の文字コードを足して8で割った余りで、色(0〜7)を決める
      - const colorNo = [...post.postedBy].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % 8
      //- 日本時間で「2026/11/26 11:33」の形にする
      - const postedAt = post.createdAt.toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' })
      - const likedByMe = post.likes.some(like => like.user === user)
      div(class=cardClass)
        div.card-body
          div.d-flex.justify-content-between.align-items-center
            div.d-flex.align-items-center
              //- 名前の頭文字を、色付きの丸の中に表示する
              span.avatar(class=`avatar-color-${colorNo}`) #{[...post.postedBy][0]}
              h5.card-title.mb-0.ms-2(class=`user-color-${colorNo}`) #{post.postedBy}
                if post.postedBy === 'admin'
                  i.bi-patch-check-fill.ms-1
            small.card-text.float-end #{postedAt}
          p.card-text.lead #{post.content}
        - const isDeletable = (user === post.postedBy || user === 'admin')
        div.card-footer.d-flex.justify-content-between
          form(method="post" action="/posts/like")
            input(type="hidden" name="id" value=post.id)
            button(type="submit" class=(likedByMe ? 'btn btn-danger btn-sm' : 'btn btn-outline-danger btn-sm'))
              i(class=(likedByMe ? 'bi-heart-fill' : 'bi-heart'))
              span.ms-1 #{post.likes.length}
          if isDeletable
            form(method="post" action="/posts/delete")
              input(type="hidden" name="id" value=post.id)
              button(type="submit").btn.btn-outline-danger.btn-sm
                i.bi-trash
    div.fixed-bottom.p-4.bg-body
      form(method="post" action="/posts" name="message-form").container-fluid.row.g-3
        div.col-12
          textarea(name="content" rows="4" maxlength="150" placeholder="Ctrl(Command)+Enterで送信できます").form-control
          input(type="hidden" name="oneTimeToken" value=oneTimeToken)
        div.col-12
          small#char-count.text-body-secondary 0 / 150
          button(type="submit").btn.btn-primary.float-end
            i.bi-send

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")
    script(src="nn-chat.js")